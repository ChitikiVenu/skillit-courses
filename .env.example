# The site's canonical public URL — every canonical tag, Open Graph/Twitter URL, JSON-LD block,
# sitemap entry and robots.txt Sitemap: line is built from this one value (src/config/site.js).
#
# When a custom domain is connected later, change this one line (here for local dev, and in the
# Environment Variables settings of the Vercel project for production) — no code changes needed.
VITE_SITE_URL=https://www.skillit.education
